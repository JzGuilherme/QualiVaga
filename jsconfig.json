{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "background.js",
    "content.js",
    "options.js",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".test-profile-auth",
    "test-results"
  ]
}
